# Gemini — generates the application materials (cover letter, CV, insights)
GEMINI_API_KEY=your_gemini_api_key_here
# Get your API key from: https://makersuite.google.com/app/apikey

# DeepSeek — powers the interactive mock-interview coach on the results page
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional: override the default coach model (deepseek-v4-flash)
# DEEPSEEK_MODEL=deepseek-v4-pro
# Get your API key from: https://platform.deepseek.com/api_keys

# Google sign-in (Google Identity Services). Create an OAuth "Web application" client in
# Google Cloud (project deepapply-app-2026) with your site origins as authorized JavaScript
# origins. The SAME client id goes in both variables: the server verifies ID tokens against
# GOOGLE_CLIENT_ID, and Vite inlines VITE_GOOGLE_CLIENT_ID into the frontend at build time.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Signs our 30-day session tokens. Any random string of 32+ chars: `openssl rand -base64 48`
SESSION_SECRET=change_me_to_a_long_random_string

# Free-tier generations per user per calendar month (default 10). Pro accounts are unlimited.
FREE_MONTHLY_GENERATIONS=10
